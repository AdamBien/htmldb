#!/usr/bin/env -S java --source 25

import module java.xml;

static final String INDEX_PAGE = "index.html";
static final String PAGE_SUFFIX = ".html";
static final String PROPERTIES_FILE = "app.properties";

String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-08-03.6";
Path dbDir = Path.of(".");

void main(String... args) throws Exception {
    Log.system(name + " " + version);
    dbDir = Path.of(loadConfiguration().getProperty("db.dir", "."));
    if (args.length == 0) {
        help();
        System.exit(1);
    }
    switch (args[0]) {
        case "-help" -> help();
        case "-version" -> {}
        case "tables" -> printLines(tableNames());
        default -> dispatch(args);
    }
}

void dispatch(String... args) throws Exception {
    var table = args[0];
    validate(table, "table");
    if (args.length < 2) {
        fail("missing command, see: " + name + " -help");
    }
    switch (args[1]) {
        case "set" -> set(table, args);
        case "get" -> get(table, args);
        case "rm" -> rm(table, args);
        case "keys" -> printLines(keys(table));
        case "list" -> printLines(listing(table));
        default -> fail("unknown command: " + args[1]);
    }
}

void set(String table, String... args) throws Exception {
    if (args.length < 4) {
        fail("usage: " + name + " <table> set <key> <field>=<value>... | <field> (value from stdin)");
    }
    var key = args[2];
    validate(key, "key");
    var page = recordPage(table, key);
    var record = Files.exists(page) ? fields(page) : new TreeMap<String, String>();
    if (args.length == 4 && !args[3].contains("=")) {
        validate(args[3], "field");
        record.put(args[3], new String(System.in.readAllBytes(), StandardCharsets.UTF_8).strip());
    } else {
        for (var index = 3; index < args.length; index++) {
            var assignment = args[index];
            var separator = assignment.indexOf('=');
            if (separator < 1) {
                fail("expected <field>=<value>, got: " + assignment);
            }
            var field = assignment.substring(0, separator);
            validate(field, "field");
            record.put(field, assignment.substring(separator + 1));
        }
    }
    saveRecord(table, key, record);
    Log.success("stored: " + table + "/" + key + PAGE_SUFFIX);
}

void get(String table, String... args) throws Exception {
    if (args.length < 3) {
        fail("usage: " + name + " <table> get <key> [field]");
    }
    var page = recordPage(table, args[2]);
    if (!Files.exists(page)) {
        fail("no such key: " + args[2]);
    }
    var record = fields(page);
    if (args.length > 3) {
        var value = record.get(args[3]);
        if (value == null) {
            fail("no such field: " + args[3]);
        }
        IO.println(value);
    } else {
        printLines(recordLines("", record));
    }
}

List<String> listing(String table) throws Exception {
    var lines = new ArrayList<String>();
    for (var key : keys(table)) {
        lines.addAll(recordLines(key + "\t", fields(recordPage(table, key))));
    }
    return lines;
}

List<String> recordLines(String prefix, SortedMap<String, String> record) {
    return record.entrySet().stream()
            .map(entry -> prefix + entry.getKey() + "\t" + entry.getValue())
            .toList();
}

void printLines(List<String> lines) {
    if (!lines.isEmpty()) {
        IO.println(String.join("\n", lines));
    }
}

void rm(String table, String... args) throws Exception {
    if (args.length < 3) {
        fail("usage: " + name + " <table> rm <key> [field]");
    }
    var key = args[2];
    var page = recordPage(table, key);
    if (!Files.exists(page)) {
        fail("no such key: " + key);
    }
    if (args.length > 3) {
        var record = fields(page);
        if (record.remove(args[3]) == null) {
            fail("no such field: " + args[3]);
        }
        saveRecord(table, key, record);
        Log.success("removed: " + args[3] + " from " + table + "/" + key + PAGE_SUFFIX);
    } else {
        Files.delete(page);
        updateTableIndex(table);
        updateRootIndex();
        Log.success("removed: " + table + "/" + key + PAGE_SUFFIX);
    }
}

void saveRecord(String table, String key, SortedMap<String, String> record) throws Exception {
    Files.createDirectories(dbDir.resolve(table));
    var definitions = record.entrySet().stream()
            .map(entry -> "    <dt>%s</dt>\n    <dd>%s</dd>".formatted(escape(entry.getKey()), escape(entry.getValue())))
            .collect(Collectors.joining("\n"));
    var list = record.isEmpty() ? "  <dl></dl>" : "  <dl>\n%s\n  </dl>".formatted(definitions);
    atomicWrite(recordPage(table, key), page(key, list + "\n" + updatedFooter()));
    updateTableIndex(table);
    updateRootIndex();
}

String updatedFooter() {
    var updated = Instant.now().truncatedTo(ChronoUnit.SECONDS);
    return """
              <footer>
                <p>updated <time datetime="%s">%s</time></p>
              </footer>\
            """.formatted(updated, updated);
}

SortedMap<String, String> fields(Path recordPage) throws Exception {
    var document = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(recordPage.toFile());
    var names = document.getElementsByTagName("dt");
    var values = document.getElementsByTagName("dd");
    var record = new TreeMap<String, String>();
    for (var index = 0; index < Math.min(names.getLength(), values.getLength()); index++) {
        record.put(names.item(index).getTextContent(), values.item(index).getTextContent());
    }
    return record;
}

List<String> keys(String table) throws Exception {
    var folder = dbDir.resolve(table);
    if (!Files.isDirectory(folder)) {
        fail("no such table: " + table);
    }
    try (var pages = Files.list(folder)) {
        return pages
                .map(page -> page.getFileName().toString())
                .filter(this::isRecordPage)
                .map(fileName -> fileName.substring(0, fileName.length() - PAGE_SUFFIX.length()))
                .sorted()
                .toList();
    }
}

boolean isRecordPage(String fileName) {
    return fileName.endsWith(PAGE_SUFFIX) && !fileName.equals(INDEX_PAGE);
}

void updateTableIndex(String table) throws Exception {
    var links = keys(table).stream()
            .map(key -> link(key + PAGE_SUFFIX, key))
            .collect(Collectors.joining("\n"));
    atomicWrite(dbDir.resolve(table).resolve(INDEX_PAGE), page(table, navigation(links)));
}

void updateRootIndex() throws Exception {
    var links = tableNames().stream()
            .map(table -> link(table + "/" + INDEX_PAGE, table))
            .collect(Collectors.joining("\n"));
    atomicWrite(dbDir.resolve(INDEX_PAGE), page(name, navigation(links)));
}

String link(String href, String label) {
    return "      <li><a href=\"%s\">%s</a></li>".formatted(href, label);
}

String navigation(String links) {
    return links.isEmpty() ? "  <nav><ul></ul></nav>" : "  <nav>\n    <ul>\n%s\n    </ul>\n  </nav>".formatted(links);
}

List<String> tableNames() throws Exception {
    if (!Files.isDirectory(dbDir)) {
        return List.of();
    }
    try (var folders = Files.list(dbDir)) {
        return folders
                .filter(Files::isDirectory)
                .filter(this::isTable)
                .map(folder -> folder.getFileName().toString())
                .sorted()
                .toList();
    }
}

boolean isTable(Path folder) {
    return Files.exists(folder.resolve(INDEX_PAGE));
}

Path recordPage(String table, String key) {
    return dbDir.resolve(table).resolve(key + PAGE_SUFFIX);
}

void validate(String identifier, String kind) {
    if (!identifier.matches("[A-Za-z0-9_][A-Za-z0-9_-]*")) {
        fail("invalid %s name: %s (allowed: letters, digits, _ and -)".formatted(kind, identifier));
    }
    if (!kind.equals("field") && identifier.equals("index")) {
        fail("'index' is a reserved %s name".formatted(kind));
    }
}

String page(String title, String content) {
    return """
            <!DOCTYPE html>
            <html xmlns="http://www.w3.org/1999/xhtml" lang="en">
            <head>
              <meta charset="utf-8"/>
              <title>%s</title>
            </head>
            <body>
            <main>
              <h1>%s</h1>
            %s
            </main>
            </body>
            </html>
            """.formatted(escape(title), escape(title), content);
}

void atomicWrite(Path target, String content) throws Exception {
    var temp = Files.createTempFile(target.getParent(), "." + name, ".tmp");
    temp.toFile().setReadable(true, false);
    Files.writeString(temp, content);
    Files.move(temp, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
}

Properties loadConfiguration() throws Exception {
    var configuration = new Properties();
    var global = Path.of(System.getProperty("user.home"), "." + name, PROPERTIES_FILE);
    var local = Path.of(PROPERTIES_FILE);
    for (var candidate : List.of(global, local)) {
        if (Files.exists(candidate)) {
            try (var reader = Files.newBufferedReader(candidate)) {
                configuration.load(reader);
            }
        }
    }
    configuration.putAll(System.getProperties());
    return configuration;
}

String escape(String text) {
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
}

void fail(String message) {
    Log.error(message);
    System.exit(1);
}

void help() {
    Log.user("""
            Usage: %s <table> <command> [arguments]

            Each record is its own XHTML page (<table>/<key>.html) holding a <dl> of fields.

            Commands:
              <table> set <key> <field>=<value>...  store fields (merged into the record)
              <table> set <key> <field>             store one field, value from stdin
              <table> get <key>                     print all fields as field<TAB>value lines
              <table> get <key> <field>             print one field value
              <table> rm <key>                      remove a record
              <table> rm <key> <field>              remove one field
              <table> keys                          print all keys, sorted
              <table> list                          print key<TAB>field<TAB>value lines
              tables                                list all tables
              -help                                 show this help
              -version                              show version

            Table, key and field names: letters, digits, _ and - ('index' is a reserved table/key name)

            Configuration (zcfg): db.dir sets the database root (default: current directory)
              ~/.%s/app.properties, ./app.properties, or -Ddb.dir=<path>
            """.formatted(name, name));
}

// zcl (https://github.com/AdamBien/zcl), trimmed; SYSTEM and SUCCESS write to
// stderr here so stdout stays pure data for piping
enum Log {

    ERROR(Color.RED, System.err),
    USER(Color.CYAN, System.out),
    SYSTEM(Color.BLUE, System.err),
    SUCCESS(Color.MAGENTA, System.err);

    private PrintStream out;

    enum Color {
        RED("\033[38;2;220;50;47m"),          // Solarized Red #dc322f
        MAGENTA("\033[38;2;211;54;130m"),     // Solarized Magenta #d33682
        BLUE("\033[38;2;38;139;210m"),        // Solarized Blue #268bd2
        CYAN("\033[38;2;42;161;152m");        // Solarized Cyan #2aa198

        String code;

        Color(String code) {
            this.code = code;
        }
    }

    private final String value;
    private final static String RESET = "\u001B[0m";

    private Log(Color color, PrintStream out) {
        this.value = (color.code + "%s" + RESET);
        this.out = out;
    }

    String formatted(String raw) {
        return this.value.formatted(raw);
    }

    void out(String message) {
        var colored = formatted(message);
        this.out.println(colored);
    }

    public static void error(String message) {
        Log.ERROR.out(message);
    }

    public static void user(String message) {
        Log.USER.out(message);
    }

    public static void system(String message) {
        Log.SYSTEM.out(message);
    }

    public static void success(String message) {
        Log.SUCCESS.out(message);
    }
}
